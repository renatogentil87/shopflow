# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# keep .terraform.lock.hcl committed (do NOT ignore it)

# Secrets / local
*.pem
*.key

# Terraform variable values.
# Env tfvars ARE committed (IP scheme / region reviewed in PR) — no secrets in them.
# Account IDs live in SSM. Everything else (bootstrap tfvars, *.auto.tfvars) stays ignored.
*.tfvars
*.tfvars.json
!infra/envs/*/terraform.tfvars
!*.tfvars.example
# EXCEPTION: *.auto.tfvars is committed on purpose (non-secret, PR-reviewed config).
# NEVER put account IDs or secrets in an *.auto.tfvars file — those go in SSM.
!*.auto.tfvars

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
